{
  "name": "shop-dva-c03-tracker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "SPA de seguimiento del proyecto Shop para DVA-C03",
  "homepage": "https://shykandev.github.io/shop-dva-c03-tracker/",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "npm run build && cp dist/index.html dist/404.html && touch dist/.nojekyll && gh-pages -d dist"
  },
  "dependencies": {
    "vue": "^3.5.42",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.10.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.3.0",
    "gh-pages": "^6.3.0",
    "jsdom": "^22.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.0",
    "vite": "^7.3.6",
    "vitest": "^4.0.0",
    "vue-tsc": "^2.1.10"
  }
}
